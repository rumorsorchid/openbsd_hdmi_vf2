# Appended to starfive_visionfive2_defconfig by build-in-container.sh
CONFIG_VIDEO=y
CONFIG_VIDEO_STARFIVE_JH7110_HDMI=y
CONFIG_CMD_JH7110_HDMI=y
CONFIG_CONSOLE_MUX=y
CONFIG_SYS_CONSOLE_IS_IN_ENV=y
CONFIG_SYS_STDIO_DEREGISTER=y
# White text on black, like any firmware console.
CONFIG_SYS_WHITE_ON_BLACK=y
# Track what U-Boot redraws, so that a cached framebuffer (no uncached view
# of DRAM found) is flushed row by row rather than whole.
CONFIG_VIDEO_DAMAGE=y
# Reading the uncached framebuffer back is slow: scroll 10 lines at a time.
CONFIG_CONSOLE_SCROLL_LINES=10
# Always boot from the compiled-in environment. Whatever a previous
# firmware (HFI, vendor U-Boot) saved in SPI flash is ignored.
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
