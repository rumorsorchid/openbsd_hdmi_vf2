--- sys/dev/fdt/simplefb.c
+++ sys/dev/fdt/simplefb.c
@@ -153,6 +153,17 @@
 	sc->sc_iot = faa->fa_iot;
 	sc->sc_paddr = faa->fa_reg[0].addr;
 	sc->sc_psize = faa->fa_reg[0].size;
+
+	/*
+	 * The StarFive JH7110 display controller does not snoop the CPU
+	 * caches, and its U74 cores ignore the page-table cacheability
+	 * bits.  Access the framebuffer through the SoC's uncached alias
+	 * of DRAM (DRAM + 16 GiB) so every write reaches memory at once.
+	 */
+	if (OF_is_compatible(OF_peer(0), "starfive,jh7110") &&
+	    sc->sc_paddr >= 0x40000000ULL && sc->sc_paddr < 0x240000000ULL)
+		sc->sc_paddr += 0x400000000ULL;
+
 	if (bus_space_map(sc->sc_iot, sc->sc_paddr, sc->sc_psize,
 	    BUS_SPACE_MAP_LINEAR | BUS_SPACE_MAP_PREFETCHABLE, &sc->sc_ioh)) {
 		printf(": can't map framebuffer\n");
